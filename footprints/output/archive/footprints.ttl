<http://data.judaicalink.org/data/footprints/133b857c-a674-585d-b4b5-d94b4ad03d91> a gndo:Work ;
    gndo:associatedPlace "Rome" ;
    gndo:author "http://data.judaicalink.org/data/footprints/9dd59f06-f28e-5eea-874b-eb29e86c704e" ;
    gndo:dateOfPublication "March 16, 1523" ;
    gndo:language "Hebrew" ;
    jl:describedAt "https://search.worldcat.org/de/title/166131526" ;
    jl:hasAbstract "Pagnini's first appearance in print and Strozzi's only publication. Both the author and publisher were Dominicans. The printing is sometimes attributed to Silber, but apparently none of the typographical and woodcut material has been recorded in his signed work. Instead of employing an established shop Pagnini and Strozzi may have set up a private press for the occasion; a papal privilege at the end stresses the high cost of production. Rare." ;
    dc:publisher "http://data.judaicalink.org/data/footprints/57eaeafb-e336-5231-a7ce-27a69dca8f72" ;
    dc:title "Enchiridion expositionis vocabulorum Haruch" ;
    dcterms:created "2024-03-17T14:55:50.110473"^^xsd:dateTime ;
    skos:prefLabel "Enchiridion expositionis vocabulorum Haruch" .

