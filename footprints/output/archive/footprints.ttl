<http://data.judaicalink.org/data/footprints/36ffe3d2-6fcb-5279-ab64-b39bda072e09> a gndo:Work ;
    gndo:associatedPlace "Cross",
        "קראקא" ;
    gndo:author "http://data.judaicalink.org/data/footprints/5896837d-ff39-5681-bb13-4611444cc305" ;
    gndo:dateOfPublication "1593 - 1596?" ;
    gndo:formerOwner "Chabad-Lubavitch Library",
        "Harry G. Friedman",
        "The Library of The Jewish Theological Seminary" ;
    gndo:language "Hebrew" ;
    gndo:owner "Chabad-Lubavitch Library",
        "The Library of The Jewish Theological Seminary" ;
    gndo:printer "http://data.judaicalink.org/data/footprints/4f9a4202-3e19-5215-afef-13a6eb29b4ad" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000308824&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0" ;
    jl:hasAbstract "",
        "The publication date is not listed explicitly on the title page. According to the JTS catalog, it was printed in 1593-95. NLI includes 2 listings for this title - ca. 1596 and ca. 1600 (both title pages appear to be very similar to the title page in the copy owned by JTS). The standardized identifier for the ca. 1596 edition was entered for this record.  In addition,  the title page portrays this work as a commentary on the bible. According to the JTS catalog and to handwritten notes in French and German on the inside cover of the book, it is a commentary on the twelve minor prophets.  The author of this book, Naftali Hirsch ben Asher Altschuler, draws the title of this commentary on the twelve minor prophetic books of the Bible from Genesis 49:15. He describes himself as a ram who has been let loose and yields lovely fawns,  from the language of Jacob's blessing to his son Naftali.<br />Subtitle: (בן... אשר) אלט שולר (הגר בארץ רוסיא)... [חלק א-ג].<br />BHB note: תיאור מפורט של שלבי העריכה וההדפסה ודיון בתאריך עיין: י'. יודלוב, קרית ספר, נד, תשם, עמ' 827-828; הנל, שם, נה, תשמא, עמ' 814. שם הוכח כי באדר שנו כבר היה הספר בדפוס וההדפסה עמדה להסתיים." ;
    dc:title "Ayalah sheluhah" ;
    dcterms:created "2024-03-17T12:09:23.748549"^^xsd:dateTime ;
    skos:prefLabel "Ayalah sheluhah" .

