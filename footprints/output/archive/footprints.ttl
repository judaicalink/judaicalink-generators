    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000109369&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://search.worldcat.org/de/title/42743249" ;
    jl:hasAbstract "Subtitle: ... קצת חדושי הלכות על מס' כתובת וחידושים וביאורים על הטור והבי ביד בהלכות יין נסך. טמון באש כתבי קודש שהניח אחריו ... ר' מאיר זלהה שהי' אבד ... אייזנשטאט ... והובא לבית הדפוס ... עי בנו ... ר' יהודה נרו מבייאלי חתן הגאון .. מו הירץ זלהה מזאלקיוי ...<br />BHB note: דף [2, ב- 4, ב]: הקדמה, מאת בן המחבר המביא את הספר לדפוס ובה חידושים בהלכה ובאגדה." ;
    dc:title "Or ha-ganuz" ;
    dcterms:created "2024-03-17T20:18:12.423152"^^xsd:dateTime ;
    skos:prefLabel "Or ha-ganuz" .

