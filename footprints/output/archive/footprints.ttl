    gndo:printer "http://data.judaicalink.org/data/footprints/42267b70-6385-5dda-a8ce-7874bf225264" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,1040707409&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0" ;
    jl:hasAbstract "All notes by Chaim Meiselman:  This is a dissertation about Hebrew cemeteries and gravestones, and some customs of Jewish burial and cemetery architechture. It is written in Latin with print formatting for quotes and verbatim epitaphs, including a translation of Hebrew to Latin on a few of the examples of epitaphs cited.The author was Johann Nicolai, a theologian at Tübingen in Germany; born 1665, died 1708.Volume printed on high quality paper with a number of high quality illustrations, some folded. Included in many of the illustrations are depictions of the burial monuments of the Prophets and other Biblical figures.Advertisements: p. [1]-[2] at end.Rubricated title." ;
    dc:publisher "http://data.judaicalink.org/data/footprints/42267b70-6385-5dda-a8ce-7874bf225264" ;
    dc:title "De sepulchris hebræorum" ;
    dcterms:created "2024-03-17T14:42:56.815449"^^xsd:dateTime ;
    skos:prefLabel "De sepulchris hebræorum" .

