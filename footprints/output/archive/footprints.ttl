    gndo:language "Aramaic",
        "Hebrew" ;
    gndo:owner "Chaim Meiselman" ;
    gndo:printer "http://data.judaicalink.org/data/footprints/6dcc2c90-7caf-5ee9-a7bd-86beb5efe303" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000182053&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://search.worldcat.org/de/title/233345992" ;
    jl:hasAbstract "The Midrashic text, Tanna Devei Eliyahu, first appeared in Venice, 1598. The present edition prepared by the Kabbalist R. Samuel Haida, contains alternate versions: “Nuscha Chadasha” (new text) and “Nuscha Yeshana” (old text) - being wholly changed from its original form with Talmudic and Kabbalistic interpolations. This Prague edition consists of three parts, the first two of which contain the text of the Rabbah and the Zuta versions of the Midrash (31 and 29 chapters respectively). These two parts are preceded by introductory essays: “Mar Kashisha” or “Sod Malbush HaNeshamah,” “Mar Yanuka” or “Sod Haluka DeRabbanan,” and “Sha’ar Shemuel.”",
        "first edition" ;
    dc:publisher "http://data.judaicalink.org/data/footprints/6dcc2c90-7caf-5ee9-a7bd-86beb5efe303" ;
    dc:title "Sifra Ziḳuḳin de-nura u-viʻurin de-esha" ;
    dcterms:created "2024-03-18T00:39:44.646530"^^xsd:dateTime ;
