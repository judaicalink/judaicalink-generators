    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000120673&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0" ;
    jl:hasAbstract "Subtitle: ספר ראבן ... שעד עתה לא נדפס בדפוס ... מאיזה סיבות... היה טמון וגנוז וכמוס ... כחמש מאות שנים ... ושאלנו ולא שמענו משום אדם שראה או ששמע ... ממהות זה הספר ... הנקרא אבן העזר. שחיבר הרב רבינו אליעזר בר נתן, הנקרא ראבן בפי כל הפוסקים ... דברים חדושים ... בפסקים דינים ומשפטים ישרים וגם פיר' עמקי הלכות ושיטות בכל שיטות התלמוד באשר שהם סדורים ... ומנהגי מנהג וותיקין מקדמונים ... עפ הגמרא ושיטת התלמוד בששה סדרים ...<br />BHB note: על ההסכמה עיין: י' היילפרין, פנקס ועד ארבע ארצות, ירושלים תשה, עמ' 26." ;
    dc:publisher "http://data.judaicalink.org/data/footprints/ef9a52ae-8932-5265-9b3e-a51aa47d961c" ;
    dc:title "Even ha-Ezer" ;
    dcterms:created "2024-03-17T15:08:11.449125"^^xsd:dateTime ;
    skos:prefLabel "Even ha-Ezer" .

