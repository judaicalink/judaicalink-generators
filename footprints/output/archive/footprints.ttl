<http://data.judaicalink.org/data/footprints/88e824da-0aff-56a9-9756-9b73f4e6c506> a gndo:Work ;
    gndo:associatedPlace "Fiorda",
        "Fürth",
        "Polonne",
        "פיורדא" ;
    gndo:author "http://data.judaicalink.org/data/footprints/df277904-c112-5374-b33a-29022a4dbaba",
        "http://data.judaicalink.org/data/footprints/e2fb0a1f-8521-5543-ab57-a73e731ef79b" ;
    gndo:dateOfPublication "1738",
        "1766",
        "1805" ;
    gndo:formerOwner "Aaron Casale",
        "Aaron Fano",
        "Baltimore Hebrew College",
        "Chaim Meiselman",
        "Columbia University Libraries",
        "Communita Ebraica di Venezia",
        "Joseph Meyerhoff Collection, Towson University Library" ;
    gndo:language "Hebrew" ;
    gndo:owner "Chaim Meiselman",
        "Columbia University Libraries",
        "Communita Ebraica di Venezia",
        "Joseph Meyerhoff Collection, Towson University Library" ;
    gndo:printer "http://data.judaicalink.org/data/footprints/2ea39291-0fdd-52ce-8473-7bdc539f2f61",
        "http://data.judaicalink.org/data/footprints/4f98b81a-96a4-5db0-a736-d07fe3c831b7" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000162122&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000162123&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000162124&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0" ;
    jl:hasAbstract "all notes by Chaim Meiselman:  notes    Running title: Leḥem ha-panim.      This is a work based on the text of the Shulhan Arukh Yoreh De’ah, dealing with the Halakhic dietary laws. The content of the lines are mostly Pilpulistic and lengthy; some are elucidative and descriptive in nature.      The author of the volume was Moses-Jekuthiel ha-kohen Kaufmann, a dayan (rabbinical judge) in Krotoschin (now Krotoszyn in the greater Kalisz area in central-west Poland) and later in Kutno in the greater Łódź area, also in Poland. He was the son-in-law of Abraham Abele Gombiner (1633-1683), author of ’Magen Avraham’. He wrote a number of Halakhic works.      Haskamot of Joseph b. Menahem Steinhardt of Fürth, dated 1 Tevet 1765; Nathaniel Weill of Karlsruhe and the Baden-Durlach Margraviate, 1 Tamuz 1765. Added printer: Jakob Buchbinder of Wilhermsdorff, presiding in Fürth.   references    Friedberg, Beit Eked Sefarim, lamed 330 : 4." ;
    dc:contributor "http://data.judaicalink.org/data/footprints/96d7eb0f-d9d2-5225-8961-b7367fbb25c0",
        "http://data.judaicalink.org/data/footprints/a6dc2643-db72-547f-9c2b-36ab12e0d4e1" ;
    dc:publisher "http://data.judaicalink.org/data/footprints/f9ae50fd-0c12-5a29-a35f-0632094d076e" ;
    dc:title "Lehem ha-Panim" ;
    dcterms:created "2024-03-17T16:53:07.210195"^^xsd:dateTime ;
    skos:prefLabel "Lehem ha-Panim" .

