<http://data.judaicalink.org/data/footprints/0269e884-8f80-555e-b274-daaa4fc5d9a2> a gndo:Work ;
    gndo:associatedPlace "Amsterdam",
        "אמשטרדם" ;
    gndo:author "http://data.judaicalink.org/data/footprints/8fb07119-f256-50b1-a4a9-3dc31d131f3e",
        "http://data.judaicalink.org/data/footprints/cd187cd8-4c9c-5262-b49f-e89820d4a1be" ;
    gndo:dateOfPublication "1746" ;
    gndo:language "Hebrew" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000152489&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0" ;
    jl:hasAbstract "",
        "This collection of folktales, designed to strengthen faith, is likely the first prose work in medieval Hebrew literature - so paving the way for the Hebrew belletristic form as a literary genre. Stemming from the Tunisian city of Kairouan, the author was one of the outstanding leaders of North African Jewry flourishing in the first half of the 11th century.<br />BHB note: על המקור שממנו נדפסה מהדורה זו, עיין ש' אברמסון, רב נסים גאון , ירושלים תשכה, עמ' 380-382." ;
    dc:contributor "http://data.judaicalink.org/data/footprints/72480b2c-9399-5fab-8707-11c7f3504720" ;
    dc:title "Hibur Yafeh Me-ha-yeshu'a" ;
    dcterms:created "2024-03-17T15:30:03.804443"^^xsd:dateTime ;
    skos:prefLabel "Hibur Yafeh Me-ha-yeshu'a" .

