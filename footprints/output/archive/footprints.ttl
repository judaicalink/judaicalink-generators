<http://data.judaicalink.org/data/footprints/d93561a4-844d-59a9-8ebe-3f83e5259515> a gndo:Work ;
    gndo:associatedPlace "Lunéville",
        "Riva del Garda" ;
    gndo:author "http://data.judaicalink.org/data/footprints/2dd69786-ce99-5e70-a661-0adfc3d963d4" ;
    gndo:dateOfPublication "1562",
        "1806" ;
    gndo:formerOwner "Baltimore Hebrew College",
        "British Library (British Museum)",
        "David Kaufmann",
        "Jewish Library Association of Baltimore",
