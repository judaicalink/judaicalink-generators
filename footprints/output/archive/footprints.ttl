<http://data.judaicalink.org/data/footprints/99241506-db63-5bc3-890d-d14cfee9b1d0> a gndo:Work ;
    gndo:associatedPlace "Winniga",
        "וויניציאה" ;
    gndo:compiler "http://data.judaicalink.org/data/footprints/928b289b-42a2-5d14-b147-428f1ccb1f0e" ;
    gndo:dateOfPublication "1694 - 1695" ;
    gndo:formerOwner "Joseph T. and Susan A. Moldovan",
        "University of Pennsylvania Libraries" ;
    gndo:language "Hebrew",
        "Italian" ;
    gndo:owner "University of Pennsylvania Libraries" ;
    gndo:printer "http://data.judaicalink.org/data/footprints/ae1c2ce1-b8b9-5c22-93f3-0c2c7652988a" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,1131723556&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0" ;
    jl:hasAbstract "All notes by Chaim Meiselman: Text in Hebrew, translated to Judeo-Italian; with a poem in Yiddish (fol. 26b). Title in architectural design with verses on the borders. There is an illustration of a plan for Ezekiel's Temple on the title page verso, with a citation of R. Yom Tov Lipmann Heller's Tsurat ha-bayit, printed in Prague in 1602. Each page is laid out in an architechtural style, with the text of the Haggadah in the center portion, the Judeo-Italian translation in the lower portion, and the commentary Tseli esh on the outer columns. Profusely illustrated. Illustrations include scenes from the Passover Seder the Bible of the slavery in Egypt (with contemporary dress), illustrated and illuminated letters, and illustrations of the service in the Temple and the sacred vessels. Signatures: 1-3⁶4⁸." ;
    dc:title "Haggadah. Hebrew and Judeo-Italian." ;
    dcterms:created "2024-03-17T15:16:29.755275"^^xsd:dateTime ;
    skos:prefLabel "Haggadah. Hebrew and Judeo-Italian." .

