<http://data.judaicalink.org/data/footprints/6029da5a-157c-525c-aede-d0830efa8a68> a gndo:Work ;
    gndo:associatedPlace "Berlin",
        "Prague",
        "ברלין",
        "פראג" ;
    gndo:author "http://data.judaicalink.org/data/footprints/0444622f-51e5-5fd8-8850-0f83fb9470cd",
        "http://data.judaicalink.org/data/footprints/59c7885d-4ad2-5b24-a85f-af3ce36716e6",
        "http://data.judaicalink.org/data/footprints/630778b9-3e61-5b91-81f1-978c97969fcb",
        "http://data.judaicalink.org/data/footprints/833b9021-8cf9-5375-a7a9-81ef044d6494" ;
    gndo:dateOfPublication "1610",
        "1784" ;
    gndo:formerOwner "Moshe ben Yitshak",
        "University of Vienna" ;
    gndo:language "Hebrew" ;
    gndo:owner "Moshe ben Yitshak",
        "University of Vienna" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000140138&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000152958&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0" ;
    jl:hasAbstract "Subtitle: ... והא ביאור על כל מלות זרות הנמצא' בכל ספר הזוהר וכמעט שהוא פי' קצר... חברו... ר' יששכר בער במוהרר משה פתחיה זצל הדר בקק קרעמניץ...<br />BHB note: דף ד,ב: שיר ושבח להרשבי [מאת ר' שמעון לביא]. פותח: בר יוחאי נמשחת אשריך. שמן ששון מחבריך. שם, עמ' 58, מס' 1340.",
        "Subtitle: ... ילמד דעת שהקבלה והחקירה... אחיות תאומות... נאום (יצחק סטאנוב) המביא... לבית הדפוס, זה הס' מצאתי בבית עקד הספרים... בכי עם הסכמות מגאונים הקדמונים, ושם מחברו פלאי... וגאוני זמננו...ראו... ויחלו פני... לקבעו בדפוס...<br />BHB note: עי' על ההסכמות: יודע ספר, עמ' 27, מס' 152; קהלת משה, שם; ישראל צינברג, תולדות הספרות ישראל, כרך ה, תל-אביב 1959, עמ' 119. לדעתם ההסכמות מזוייפות. אך נראים דברי י' קלוזנר, היסטוריה של הספרות העברית החדשה, כרך א, ירושלים תשיב, עמ' 168, כי רק שתי ההסכמות הראשונות מזוייפות." ;
    dc:title "Imre Binah" ;
    dcterms:created "2024-03-17T16:10:08.724072"^^xsd:dateTime ;
    skos:prefLabel "Imre Binah" .

