    gndo:language "German",
        "Hebrew",
        "Yiddish" ;
    gndo:owner "Joseph Meyerhoff Collection, Towson University Library",
        "Russian State Library" ;
    gndo:printer "http://data.judaicalink.org/data/footprints/0e9d0006-f050-5cbf-89ca-2f7a682a46a1",
        "http://data.judaicalink.org/data/footprints/3bd4cad7-fd93-52f2-80fc-15d142572d1d" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,002069448&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0" ;
    jl:hasAbstract "Notes by Chaim Meiselman :   l. ii : Subskribentn Lisste, subscription lists, or prenumariten.  General Note  Printed double-columns with bold headings. Footnotes in Rashi script of Yiddish-Daitsh translations of Hebrew words above. Volume ends in appendix, with running title 'Motsa ha-Shorashim.  General Note  Censor imprint : Carolus, i.e. Karl Fischer of Prague, who had the title Censor-in-Hebraicis. Fischer was an apostate Jew living in Prague; he worked as a censor of Hebrew and Yiddish texts, as well as a librarian to the Imperial-Royal-Concilliator. While he censored a large number of books, this volume was brought to print by a member of the Fleckeles family and a close relative of Ele'azar ben David Fleckeles (1754-1826), chief Rabbi of Prague. I mention this name because Fischer and Fleckeles had an extensive correspondence; see Spitz, Yom-Tov (Jonas), Zikhron Elazar (Prague : Landau, 1827), pp. 41-43. CM  Citation/Ref. Note    Steinschneider, Cat. Libr. Bodl.,   7093 : 14  General Note  Zweite Verbesserte Auflage.  General Note  Rubricated title." ;
    dc:title "Shorashim (Satanow, Isaac)" ;
    dcterms:created "2024-03-18T00:04:28.280146"^^xsd:dateTime ;
    skos:prefLabel "Shorashim (Satanow, Isaac)" .

