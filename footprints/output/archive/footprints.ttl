<http://data.judaicalink.org/data/footprints/6488f09a-0e36-59f2-80c8-d021ea931b84> a gndo:Work ;
    gndo:associatedPlace "Thessaloniki" ;
    gndo:author "http://data.judaicalink.org/data/footprints/1a38acae-0af4-5ff5-b167-0000c0329f25" ;
    gndo:dateOfPublication "1651",
        "1713 - 1722" ;
    gndo:dedicatee "http://data.judaicalink.org/data/footprints/b6968146-bdc7-5c41-964a-97f755d5d567" ;
    gndo:formerOwner "Baltimore Hebrew College",
        "Chaim Meiselman",
        "Joseph Meyerhoff Collection, Towson University Library",
        "Yesha'yah Yo'av",
        "Yo'av Sha'ul Urva" ;
    gndo:language "Aramaic",
        "Hebrew" ;
    gndo:owner "Chaim Meiselman",
        "Joseph Meyerhoff Collection, Towson University Library" ;
    gndo:printer "http://data.judaicalink.org/data/footprints/1e9ff66c-8a91-5478-9718-ec9ffaecfd11",
        "http://data.judaicalink.org/data/footprints/6118dd36-99ef-5489-8a4e-8620033626e1",
        "http://data.judaicalink.org/data/footprints/726fb082-c707-5d16-acc3-1109cfa59157" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000180589&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,001790667&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0" ;
    jl:hasAbstract "All notes by Chaim Meiselman:  notes    This is the first of three volumes of Ḥayyim-Shabbetai ha-kohen’s responsa for specifically the Shulḥan ʻArukh Ḥoshen ha-Mishpaṭ to be printed in succession (1713, 1715, 1722), all at Saloniki. The author was the rabbinical head of the Saloniki Jewish community.      Ornament rows on title. On the title recto, a large ornamental shield is featured with a Three of Swords and the double-crowned eagle, in a scheme with caryatids supporting the structure. This is likely symbolism of the Greek Orthodox Church, with some variant to similar depictions in the details of the woodcut.      Benefactors for the cost of printing the volume are listed on the title in a long statement.      With a dedication to Sultan Ahmed III (1673-1736) of the greater Ottoman Empire.   references    Steinschneider, M. Cat. Libr. Bodl., 4708 : 2.",
        "First printing. Also with קונטרס ערוך איגונא דאתתא" ;
    dc:title "She'elot u-Teshuvot (Hayyim Shabtai ha-kohen)" ;
    dcterms:created "2024-03-17T22:24:56.309598"^^xsd:dateTime ;
    skos:prefLabel "She'elot u-Teshuvot (Hayyim Shabtai ha-kohen)" .

