    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000146596&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000146599&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
