<http://data.judaicalink.org/data/footprints/03e87f9c-fa70-5b07-9c04-708d74af2a6a> a gndo:Work ;
    gndo:associatedPlace "Fiorda",
        "פיורדא" ;
    gndo:author "http://data.judaicalink.org/data/footprints/976cafc2-736d-5a90-a52d-40d7955f3e99" ;
    gndo:dateOfPublication "1767" ;
    gndo:formerOwner "Baltimore Hebrew College",
        "Israelitische Kultusgemeinde",
        "Joseph Meyerhoff Collection, Towson University Library",
        "Naḥum Dober Fridman",
        "Shalom Yosef ben ha-Rav Naḥum Dov Friedman",
