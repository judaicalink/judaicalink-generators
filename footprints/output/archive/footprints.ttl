    gndo:owner "Hebrew Union College Jewish Institute of Religion, Klau Library Cincinnati",
        "Library and Archives Canada" ;
    gndo:printer "http://data.judaicalink.org/data/footprints/63925f45-10a8-54da-a4ed-023f8a4bbba5" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000333273&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0" ;
    jl:hasAbstract "",
        "this is volume 43 of the printing of the Talmud by Bomberg that began in 1520.  Included in this volume are tractates that have no Gemara. Here we have just the mishnah and excerpts from Rabbeinu Shimshon's comments (Tosafot).  These tractates include: Keilim, Ohalot, Negaim Parah, Makhshirin, Zavim, Tavul Yom, Yadayim, Uktzim, Tohorot" ;
    dc:title "Mishnah. Tohorot (Order)" ;
    dcterms:created "2024-03-17T19:04:55.751178"^^xsd:dateTime ;
    skos:prefLabel "Mishnah. Tohorot (Order)" .

