<http://data.judaicalink.org/data/footprints/2bb110a7-fef1-5839-a971-cd13ebdf96a1> a gndo:Work ;
    gndo:associatedPlace "Fiorda",
        "Lviv (Lemberg)",
        "פיורדא" ;
    gndo:author "http://data.judaicalink.org/data/footprints/e67f40a9-a788-50a8-8f01-6191873a980d" ;
    gndo:compiler "http://data.judaicalink.org/data/footprints/71da470a-9f37-51fa-8c45-f44d524ed013" ;
    gndo:dateOfPublication "1766",
        "1861" ;
    gndo:formerOwner "Avraham",
        "Avraham A. Price",
        "Baltimore Hebrew College",
        "Joseph Meyerhoff Collection, Towson University Library",
        "Russian State Library",
        "The Thomas Fisher Rare Book Library, University of Toronto",
        "Yosef Yitzhak Schneerson (Sixth Lubavicher Rebbe)",
        "Yosef(?)",
        "יצחק זדה(?)" ;
    gndo:language "Hebrew" ;
    gndo:owner "Joseph Meyerhoff Collection, Towson University Library",
        "Russian State Library",
        "The Thomas Fisher Rare Book Library, University of Toronto" ;
    gndo:sponsorOrPatron "http://data.judaicalink.org/data/footprints/8505f05b-b045-5455-9d1c-4f9b2d3cd7ec" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000165087&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000165089&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://search.worldcat.org/de/title/27937364" ;
    jl:hasAbstract "",
        "ṿe-aḥar moto zakhah ve-zikah et ha-rabim ve-hotsiam le-or 'olam beno ha-rav ar.yehudah leib ben ha-memaleh maḳom le-aviv. Translation: After his death his son Aryeh Yehudah Leib helped bring to light the work of his father (by printing his responsa).  The Jewish Encyclopedia cites David b. Isaac Ottensoss as a Fürth printer active in 1727, this may be the same charachter as the editor here. See online at http://www.jewishencyclopedia.com/articles/14371-thiengen search Ottensoss  Steinschneider records that the type was set in Altdorf but was printed in Fürth. Friedberg listed them as two, but revised it to say it was one printing. Ben-Jakob doesn't correct the same mistake. Zedner mentiones the title but omits the entry (see index, pp. 871)! -- Chaim Meiselman  (Note that BHB claims it's Ferrara/Amsterdam, but Vinograd and other bibliographers agree on Altdorf/Furth)" ;
    dc:title "She'elot u-teshuvot (Menahem Mendel Krokhmal)" ;
    dcterms:created "2024-03-17T22:34:25.149180"^^xsd:dateTime ;
    skos:prefLabel "She'elot u-teshuvot (Menahem Mendel Krokhmal)" .

