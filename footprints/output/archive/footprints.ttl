<http://data.judaicalink.org/data/footprints/bddb074f-0a2b-5e20-9713-00d054a98c01> a gndo:Work ;
    gndo:associatedPlace "Francofurti ad Moenum",
        "Frankfurt to Main" ;
    gndo:author "http://data.judaicalink.org/data/footprints/771be3fe-708e-5715-ac82-32660f067e41" ;
    gndo:dateOfPublication "1721" ;
    gndo:language "Aramaic",
        "Hebrew",
        "Yiddish" ;
    jl:describedAt "https://search.worldcat.org/de/title/762348210" ;
    jl:hasAbstract "Akdamot is a prominent liturgical poem (piyyut) written in Aramaic, by Rabbi Meir bar Yitzchak of Orléans in the late 11th century. The poem is an elaborately rhymed paean of praise for God, His Torah, and His people. To this day, Akdamot is recited in almost all Aschkenazic synagogues on the first day of Shavuot, at the beginning of the Torah reading. The printer Moses ben Kalman Speyer explains the reason for this minuscule volume on the first title page: “So that each one may carry it close to their bosom and not search endlessly [for the text, which was absent from most prayer books of the time.]” The edition also features an interlinear translation of the difficult poetic Aramaic into Yiddish, so that readers would fully understand the words they were reciting. To further enhance the desirability and functionality of this small volume, Speyer also included another text recited only on Shavuot - the Book of Ruth." ;
    dc:publisher "http://data.judaicalink.org/data/footprints/85fe6c9f-5341-5d72-b504-0687a2652238" ;
    dc:title "Akdamot Vegam Ruth" ;
    dcterms:created "2024-03-17T11:12:37.910607"^^xsd:dateTime ;
    skos:prefLabel "Akdamot Vegam Ruth" .

