<http://data.judaicalink.org/data/footprints/13c3bcf2-ca7e-517e-b53d-c023f50ece62> a gndo:Work ;
    gndo:associatedPlace "Amsterdam" ;
    gndo:author "http://data.judaicalink.org/data/footprints/1899511a-19f0-5a72-86f3-4c5c71f245b3" ;
    gndo:dateOfPublication "1655" ;
    gndo:language "Hebrew" ;
    jl:hasAbstract "Descended from a noble Marrano family, the author (c. 1570–c. 1635) studied Kabbalah under the guidance of R. Yisrael Sarug, one of the major disciples of Isaac Luria, and was the first to undertake a systematic philosophical interpretation of Kabbalistic thought, originally writing in Spanish. De Herrera was held in high esteem by Menasseh ben Israel, indeed he provided an approbation to Menasseh’s ‘Conciliador’ in 1632." ;
    dc:title "Kabbalistic Discourses" ;
    dcterms:created "2024-03-17T16:17:43.591384"^^xsd:dateTime ;
    skos:prefLabel "Kabbalistic Discourses" .

