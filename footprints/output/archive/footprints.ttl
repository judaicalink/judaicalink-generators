        "Joseph Meyerhoff Collection, Towson University Library" ;
    gndo:printer "http://data.judaicalink.org/data/footprints/313509a3-8dbb-5401-99b1-68ab7b8996b1" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000201640&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000304723&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0" ;
    jl:hasAbstract "Notes by Chaim Meiselman:  This is a rare miniature edition of the Hebrew bible, printed in one bloc-column per page. The pentateuch is printed at the center, while the Aramaic Targum (called Onkelos) is printed below.Accompanying the text are notes printed along the margins length-down. These include instructions of pronunciation and cantillation; also in some lines are pointers to the commandments as numbered and enumerated by Maimonides in his Sefer ha-Mitsvot. Verse numbers are in Arabic numerals at the edges of the column." ;
    dc:contributor "http://data.judaicalink.org/data/footprints/446850f9-3255-55f0-9549-5893186b5cfa" ;
    dc:publisher "http://data.judaicalink.org/data/footprints/bfcb5736-fb0e-50a1-9410-7683871785fe" ;
    dc:title "Bible. Targumim" ;
    dcterms:created "2024-03-17T14:25:28.930995"^^xsd:dateTime ;
    skos:prefLabel "Bible. Targumim" .

