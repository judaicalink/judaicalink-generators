    gndo:formerOwner "Hebrew Union College Jewish Institute of Religion, Klau Library Cincinnati",
        "Jacob Lowy",
        "Library and Archives Canada",
        "Meir b. Benjamin Wolff Katz" ;
    gndo:language "Aramaic",
