<http://data.judaicalink.org/data/footprints/9a34b76c-59eb-5adb-976b-217ad257ccb6> a gndo:Work ;
    gndo:associatedPlace "Alduna",
        "Bad Homburg in front of the height",
        "Bad Homburg vor der Höhe",
        "Hamburg",
        "אלטונא" ;
    gndo:author "http://data.judaicalink.org/data/footprints/d2468e5f-694e-5d1c-af85-8c663d4c8471" ;
    gndo:dateOfPublication "1736",
        "1740 - 1741",
        "1746 - 1747" ;
    gndo:formerOwner "Acele Elise",
        "Baltimore Hebrew College",
        "Berthold Strauss",
        "Eizek-Löb b. Akiva Trennenz",
        "Jakob b. Seligmann",
        "Joseph Meyerhoff Collection, Towson University Library",
        "Mendel Gottesman Library Special Collections, Yeshiva University",
        "Shelomoh Bergheim",
        "Shelomoh Segeler",
        "University of Cape Town Libraries",
        "University of Pennsylvania Libraries" ;
    gndo:language "Hebrew" ;
    gndo:owner "Joseph Meyerhoff Collection, Towson University Library",
        "Mendel Gottesman Library Special Collections, Yeshiva University",
        "University of Pennsylvania Libraries" ;
    gndo:printer "http://data.judaicalink.org/data/footprints/05ab80f7-00ab-546b-bf31-9c93613c0e13",
        "http://data.judaicalink.org/data/footprints/9f6715bc-c360-56f1-82c3-62b9b114ab64",
        "http://data.judaicalink.org/data/footprints/fc41ee7b-367c-5164-aa2e-eec2750ab020" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000175857&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000175858&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000316568&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://search.worldcat.org/de/title/708696712" ;
    jl:hasAbstract "",
        "<p>All notes by Chaim Meiselman: notes Title heavily decorated. Cherubic figures line the heading; Moses (holding the Tablets of the Law) and Aaron (in the Priestly Garb) flank the side-architechture, and an engraving of Hamburg (from the southern fortifications) is featured below. Visible is the Altstadt, or Old Town, with a small element of the Norderelbe (North Elbe river) at the west. This is the second printing of the Ḥidushim of Me&rsquo;ir b. Jakob Schiff, who was the rabbinical head of the community of Fulda in Hesse, Germany. The first printing was completed in 1736-7, also in Hamburg, but contained far less than the current item, printed a decade later. With the Haskamah of Jacob Joshua Falk of Frankfurt, signing 13 Elul 1745; below this are congratulatory notes written by the editor Mikhel b. Wolff ha-kohen Strauss of Frankfurt, as well as that of his brother Mosheh b. Wolff Strauss. The printer for the first edition was Aaron Dessau, and he is likely the printer for this edition as well; no printer is mentioned on the title. The volume ends with five leaves of homiletic material; included in this is a paragraph describing the Leviathan, including it&rsquo;s measure, habitat, and resemblances on Earth; see leaf 79 verso (sub verbo &rsquo;לויתן קראת עבד&rsquo;, Leviathan, as called &rsquo;the servant&rsquo;). references Steinschneider, M. Cat. Libr. Hebr. Bodl., p. 1715, 6325 : 2 Friedberg, Beit Eked Sefarim, Ḥet 130, 2</p>",
        "Title pages printed with second volume (BHB)" ;
    dc:contributor "http://data.judaicalink.org/data/footprints/0e47d7ed-de32-560a-8143-3d96575a6940" ;
    dc:title "Hidushe Halakhot (Meir b. Jacob Schiff)" ;
    dcterms:created "2024-03-17T15:31:03.197778"^^xsd:dateTime ;
    skos:prefLabel "Hidushe Halakhot (Meir b. Jacob Schiff)" .

