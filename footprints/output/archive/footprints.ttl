<http://data.judaicalink.org/data/footprints/602d1451-b01c-5d26-b600-b8ad3e5b7c10> a gndo:Work ;
    gndo:associatedPlace "Uffenheim" ;
    gndo:author "http://data.judaicalink.org/data/footprints/2fcc9b17-657d-56af-b900-4372025b92aa" ;
    gndo:dateOfPublication "1764" ;
    gndo:language "German",
        "Hebrew" ;
    jl:hasAbstract "This is a two-part text. The first is a comprehensive equestrian and verterinary manual. The second is quite unsual: a 36-page Hebrew/Yiddish dictionary with over 1500 words - even whole phrases - transliterated into Gothic letters and with German translation. The goal of this was probably to help German horsedealers to avoid being disadvantaged in business with Jews." ;
    dc:publisher "http://data.judaicalink.org/data/footprints/e95a267d-b276-51c6-ac8a-2a93cf6809eb" ;
    dc:title "The Complete Horse-Guide" ;
    dcterms:created "2024-03-18T01:31:29.304664"^^xsd:dateTime ;
    skos:prefLabel "The Complete Horse-Guide" .

