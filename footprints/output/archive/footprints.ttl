<http://data.judaicalink.org/data/footprints/cdf11796-9303-5e4e-87df-acf5ac38fd4a> a gndo:Work ;
    gndo:associatedPlace "Prague",
        "פראג" ;
    gndo:author "http://data.judaicalink.org/data/footprints/4ff70e34-fcc7-538f-83a1-68f2338c2ef2" ;
    gndo:dateOfPublication "1803" ;
    gndo:ditor "http://data.judaicalink.org/data/footprints/4e8335bc-a805-5cc1-8e00-dccf7bad8564" ;
    gndo:formerOwner "Baltimore Hebrew College",
        "Joseph Meyerhoff Collection, Towson University Library",
        "Russian State Library",
