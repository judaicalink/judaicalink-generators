        "http://data.judaicalink.org/data/footprints/b60b9243-c606-51ed-ae86-1cdfa2c54d1b" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000156197&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
