<http://data.judaicalink.org/data/footprints/7edd2a60-086f-5410-b464-270ee30c4cdf> a gndo:Work ;
    gndo:associatedPlace "Amsterdam",
        "Sudes",
        "Sudylkiv",
        "Warsaw",
        "אמשטרדם" ;
    gndo:author "http://data.judaicalink.org/data/footprints/98a00e0e-baae-5040-b391-20c9e04cf470",
        "http://data.judaicalink.org/data/footprints/9d69d4f8-0f16-5257-9b8f-b0b933fbf2f8",
        "http://data.judaicalink.org/data/footprints/feca76c5-2848-5446-adcf-74e3706a652d" ;
    gndo:dateOfPublication "1721",
        "1836",
        "1901",
        "1903" ;
    gndo:formerOwner "Russian State Library",
        "Shmuel Zanvill Segel (Samuel Levy), of Balbronn",
        "Yosef Yitzhak Schneerson (Sixth Lubavicher Rebbe)" ;
    gndo:language "Aramaic",
        "Hebrew" ;
    gndo:owner "Russian State Library",
        "Shmuel Zanvill Segel (Samuel Levy), of Balbronn" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000112180&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000112193&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000112205&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://search.worldcat.org/de/title/122752814",
        "https://search.worldcat.org/de/title/122842801",
        "https://search.worldcat.org/de/title/500649792" ;
    jl:hasAbstract "",
        "Subtitle: והוא חדושי בבא מציעא, אשר קבצם הרב המוסמך .... בצלאל אשכנזי זל ... וקראו בשם שיטה מקובצת. וזה לשונו בכתיבת יד אות באות, חדושי בבא מציעא מקובצים מחדושי רבינו חננאל זל, והראבד זל, והרמבן זל, ורבינו יהונתן זל, והר מאיר הכהן זל מסרקסטה מכתיבת יד המחבר <הוא הרמך>, ותוספי הראש זל, והרשבא זל, והריטבא זל, והרן זל, ושיטה לא נודע שם המחבר. ותוספות שאנץ זל, ותוספות תלמיד הרף זל, ופירוש סוגיות להר יוסף הלוי ן' מיגש נמצאו בכלל תשובותיו קצתם בלשון ערבי והועתקו ללשון הקדש וקצתם נמצאו בלשון הקודש. הויכוח שעבר בין הראבד ובין הרז הלוי בסוגיית שתי פרות. קצת תוספי תוספות להראש בתחלת פק [פרק קמא], חדושים יפים מרבנים קדמונים נמצאו בגיליון של תוספות ונקראו בשם גיליון תוספות, וביאורים יפים על תוספות ועל הגליונות של תוספות עד סוף סוגיית תגרי לוד מרב גדול לא נודע שמו נקרא בשם גיליון. קצת מפי הר יצחק בר ששת זל, וקצת מהר שמעון בר צמח זל, וקצת פלפול למהרי אבוהב זל. ופירוש סוגיית תגרי לוד ממהרר דוד ן' אבי זמרה נרו עם סוגיות אחרות. ומה שהובא בספרי הדפוס כמו פסקי הראש ונמקי[!] יוסף והתוספות ... לא נכתב כאן לסיבת כי ספרי הדפוס נמצאים. עכל ... וזכני להביא לבית הדפוס ...<br />BHB note: המדפיס מודיע בשער: ובשמים עדי וסהדי בשחקים כי לא עלו על מזבח הדפוס רק חמש מאות ספרים לבד מדלית איסור ועל כן תיקר נא יקר תפארת הספר הזה בעיניכם ..." ;
    dc:publisher "http://data.judaicalink.org/data/footprints/51b268ba-ed5c-5060-946f-b7ba5936dad3" ;
    dc:title "Shitah mekubetset" ;
    dcterms:created "2024-03-17T23:33:56.573567"^^xsd:dateTime ;
    skos:prefLabel "Shitah mekubetset" .

