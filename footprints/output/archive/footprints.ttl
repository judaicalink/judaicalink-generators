<http://data.judaicalink.org/data/footprints/09ecf0fe-4c7f-536a-99ec-c96b43b07eca> a gndo:Work ;
    gndo:associatedPlace "Basel" ;
    gndo:dateOfPublication "1579" ;
    gndo:language "Hebrew" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000308449&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0" ;
    jl:hasAbstract "It is exceedingly rare to find a prayer-book in this state. The pristine nature of this copy may very likely be attributable to its having remained undisturbed for centuries in the library of Perseigne Abbey, a Cistercian Monastery near Neuchâtel, a mere fifty miles from where it came off the press in Basle. The monks were clearly unaware of the small volume’s true identity, as they mislabeled the binding to read “Biblia Hebraica.” The Siddur was later acquired by the renowned Hebrew scholar Paul Humbert (1885-1972), professor and librarian at the University of Neuchâtel." ;
    dc:publisher "http://data.judaicalink.org/data/footprints/98a73b98-b8a1-5184-a25c-b6d06185d849",
        "http://data.judaicalink.org/data/footprints/9a6e4153-99b8-50e1-8553-7bcab4ea7fa8" ;
    dc:title "Seder Tefilot MiKol HaShana K'Minhag Kehilot Ashkenazim" ;
    dcterms:created "2024-03-17T21:04:18.342041"^^xsd:dateTime ;
    skos:prefLabel "Seder Tefilot MiKol HaShana K'Minhag Kehilot Ashkenazim" .

