<http://data.judaicalink.org/data/footprints/cb769ffd-5e51-58b2-88cd-f7ba5629b982> a gndo:Work ;
    gndo:associatedPlace "Fiorda",
        "Winigat",
        "וויניציאה",
        "פיורדא" ;
    gndo:author "http://data.judaicalink.org/data/footprints/f67cb18d-a125-5f59-9787-6386b26db6a4" ;
    gndo:dateOfPublication "1652",
        "1727" ;
    gndo:formerOwner "Avraham A. Price",
        "Baltimore Hebrew College",
        "Joseph Meyerhoff Collection, Towson University Library",
        "Russian State Library",
        "Städtische Schlossbucherei Mannheim",
        "The Thomas Fisher Rare Book Library, University of Toronto" ;
    gndo:language "Hebrew" ;
    gndo:owner "Joseph Meyerhoff Collection, Towson University Library",
        "Russian State Library",
        "The Thomas Fisher Rare Book Library, University of Toronto" ;
    gndo:printer "http://data.judaicalink.org/data/footprints/d3a38de4-7c23-5d87-9185-d4a16b25f98f" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000175435&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000175436&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://search.worldcat.org/de/title/872404532" ;
    jl:hasAbstract "<p>All notes by Chaim Meiselman: notes Haskamot of Barukh Kahana Rapaport of F&uuml;rth, dated 8 Tevet 1727; Jacob Katz of Prague, dated 21 Heshvan 1726; Moses Katzenellenbogen of Ansbach-Schwabach, signing 2 Kislev 1726. Title within ornamental border. Ornaments decorate the volume as well. Printer&rsquo;s device on leaf 77 recto. Printed in double columns. The author was a rabbinic figure in the Academy of Safed likely during the latter part of the 16th century, and is cited as being contemporary to Haim b. Joseph Vital (1543-1620) during his tenure there; see R. David Conforte, Koreh ha-Dorot, ed. D. Cassel, Berlin 1846, p. 48. Edited with introduction by author&rsquo;s son, Meir ben Ḥiyya Rofe. Contains also introduction by Moses Zacuto. Title translated literally is the work of Ḥiyya, taken from a statement in the Babylonian Talmud (Ketuvot 103b), in which Judah ha-Nasi (135-ca. 217) exclaims to Hiyya the Great (ca. 180-230) how great is the work of Ḥiyya, referring to the latter&rsquo;s pledge to save the Torah from being held from the Jewish people. The larger portion of the text is composed of Hiyya Rofe&rsquo;s talmudic novellae, printed in the Talmudic Order of Tractates. The text from ls. 88 - 107 is selected responsa of Hiyya Rofe. The printer notes (above the printer&rsquo;s device on l. 77 r.) that these are the few which remain from the collection of responsa by Hiyya. references Steinschneider, M. Cat. Libr. Bodl., 4736 : 2 Friedberg, Beit Eked Sefarim, mem 3019 : 2</p>" ;
    dc:title "Maʻaseh Hiya" ;
    dcterms:created "2024-03-17T17:10:29.353514"^^xsd:dateTime ;
    skos:prefLabel "Maʻaseh Hiya" .

