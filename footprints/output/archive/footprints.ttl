<http://data.judaicalink.org/data/footprints/5d471838-d79c-5c67-aa02-c8454d69e8c1> a gndo:Work ;
    gndo:associatedPlace "Fiorda",
        "פיורדא" ;
    gndo:author "http://data.judaicalink.org/data/footprints/16b0ab89-20e6-567e-930c-47eff4e83ef0",
        "http://data.judaicalink.org/data/footprints/929731a7-6411-52ec-a43c-740a5ebf1730" ;
    gndo:dateOfPublication "1776" ;
    gndo:formerOwner "Russian State Library",
        "Yosef Yitzhak Schneerson (Sixth Lubavicher Rebbe)" ;
    gndo:language "Hebrew" ;
    gndo:owner "Russian State Library" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000137549&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://search.worldcat.org/de/title/12407869" ;
    jl:hasAbstract "Subtitle: פירש על הזוהר... בנגלה ובנסתר... אשר חיבר הרב ... צבי הירש הלוי ממשפחת... הורוויץ... והי' אבד ורמ... שלשה גלילות מדינות זאמוט (קידאן... וויזון... בירז), בן הרב ... יהושע משה אהרן הלוי, אחיו של ... ר' חיים חייקא הלוי אבד ורמ דקק הוראדנא... ועד עתה הי'... גנוז וטמון ביד ... ר' דוב בער הלוי מקק קאמניץ (מחובשי בהמ דקק ווירמיישא), בן הרב ... יהודה הלוי זצוקל... והאי דוב הי' משתוקק להדפיס האי ספרא... וסידר אותו בסידור יפה. רק הלך לעולמו... ועכשיו בא ספר הנל ליד חתנו... ר' מרדכי מאדיל הלוי (בלאא כמר יהודא זעלקי סגל זצל... ממשפחת פרענקיל) משוואבך, אשר הוסיף נופך משלו ספר קטן, מנחת עני, חדושים על מקומות חמורים ברשי ותוס'...<br />BHB note: בגוף הספר הוספות רבות מאת המסדר ר' דוב בר." ;
    dc:title "Aspaklaryah ha-meirah" ;
    dcterms:created "2024-03-17T12:05:41.728385"^^xsd:dateTime ;
    skos:prefLabel "Aspaklaryah ha-meirah" .

