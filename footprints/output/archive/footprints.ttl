    gndo:printer "http://data.judaicalink.org/data/footprints/39c43321-867a-517d-8d8a-278357ab708c",
        "http://data.judaicalink.org/data/footprints/5be3f646-16ef-5cc9-b2bd-6666b9449cfe" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000134878&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000184375&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000184376&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
