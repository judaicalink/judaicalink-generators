<http://data.judaicalink.org/data/footprints/0893c91a-5de3-5b7c-81d7-ceeaff925ee5> a gndo:Work ;
    gndo:associatedPlace "Alduna",
        "אלטונא" ;
    gndo:dateOfPublication "1664" ;
    gndo:formerOwner "Baltimore Hebrew College",
        "G.L.",
        "Joseph Meyerhoff Collection, Towson University Library" ;
    gndo:language "Arabic",
        "Hebrew",
        "Latin" ;
    gndo:owner "Joseph Meyerhoff Collection, Towson University Library" ;
    gndo:sponsorOrPatron "http://data.judaicalink.org/data/footprints/4b52eabc-7dd2-5b88-ad5b-ed1f4f194aa6" ;
    gndo:translator "http://data.judaicalink.org/data/footprints/4b3f97cc-1945-5f15-b5cc-4e1f09418d67" ;
    jl:describedAt "https://search.worldcat.org/de/title/557765189" ;
    jl:hasAbstract "<p>NOTE: There isn't an option for Syriac so I'm using Arabic. All notes by Chaim Meiselman: Added title page, engraved.This is the volume of Syriac New Testament, with an added Latin translation to specifically Matthew. The volume comes with a preface by the translator and an added introduction from Jakob Martini of Wittenburg (1570-1649). The critical notes are printed subsequent to the text with a lone title page. Finally, a Syriac-Hebrew-Latin lexicon opens the reverse reading direction of the volume.Bound with: Gutbier, &AElig;gidius, Lexicon Syriacum. Hamburgi, 1667. And his Notae criticae in Novum Testamentum Syriacum. Hamburgi, 1667.[pt. 1] Novum Domini Nostri Jesu Christi Testamentum Syriacum. 1663 -- [pt. 2] Notae criticae in Novum Testamentum Syriacum. 1667 -- [pt. 3] Lexicon Syriacum.</p>" ;
    dc:title "Bible. New Testament. Syriac." ;
    dcterms:created "2024-03-17T13:13:02.696164"^^xsd:dateTime ;
    skos:prefLabel "Bible. New Testament. Syriac." .

