<http://data.judaicalink.org/data/footprints/f189ff26-7e91-5eca-b404-935bd3a4e70f> a gndo:Work ;
    gndo:associatedPlace "Winniga",
        "וויניציאה" ;
    gndo:author "http://data.judaicalink.org/data/footprints/2c8c1235-7533-578e-a9d3-062613660eaf" ;
    gndo:dateOfPublication "1595" ;
    gndo:formerOwner "Baltimore Hebrew College",
        "Elisha Cavallion",
        "Joseph Meyerhoff Collection, Towson University Library",
        "Yitshak Cavallion" ;
    gndo:language "Hebrew" ;
    gndo:owner "Joseph Meyerhoff Collection, Towson University Library" ;
    gndo:printer "http://data.judaicalink.org/data/footprints/b66cd2ed-ca2a-54d1-b153-a483f40bbf2d" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000142287&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0" ;
    jl:hasAbstract "",
        "All notes by Chaim Meiselman:  This is the first printing of the volume 'Kli Hemdah' by Samuel Laniado of the Aleppo community. The volume consists of homiletical discourse and an array of Midrashic materials in the sermonic and longer style of this author. It is the first of a number of works which he wrote in this vein on both the Pentateuch and the Prophets.Printed in double-columns using small-sized Rashi script; page-header is in heavy bold type, while passages of Midrash being quoted are in small bold typeface.Long colophon prayer written by the author on the completion of this work, dated Tevet 514 (January 1554) in Aram, i.e. Aleppo.The title is translated literally as 'Vessel of Desirability' or closer yet 'Enviability'; taken from Hosea 13:15 and closely based on the Mishnah, Avot 3:14.Edited by Yitshak b. Mordekhai Gershon.Friedberg, B. Bet eked sefarim,v. 2 #266 no. 1 Steinschneider, M. Cat. librorum hebraeorum,#7051 no. 1BM Hebrew,p. 670" ;
    dc:title "Keli Hemdah" ;
    dcterms:created "2024-03-17T16:27:56.072698"^^xsd:dateTime ;
    skos:prefLabel "Keli Hemdah" .

