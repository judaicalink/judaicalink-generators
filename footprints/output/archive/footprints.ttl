<http://data.judaicalink.org/data/footprints/233dbf47-73b0-518e-8e6f-f3ad0a0e3f76> a gndo:Work ;
    gndo:associatedPlace "Francofurti ad Moenum",
        "Frankfurt to Main" ;
    gndo:author "http://data.judaicalink.org/data/footprints/982fdb3c-9caa-5cb8-8ea0-a48e9402280a" ;
    gndo:dateOfPublication "1711" ;
    gndo:formerOwner "Baltimore Hebrew College",
        "Joseph Meyerhoff Collection, Towson University Library",
        "Selig Adler",
        "Seligman Schutzgrünnde (Peckelsheim)",
        "Yehuda b. Asher (Peckelsheim)" ;
    gndo:language "Hebrew",
        "Yiddish" ;
    gndo:owner "Joseph Meyerhoff Collection, Towson University Library" ;
    jl:describedAt "https://search.worldcat.org/de/title/19201763" ;
    jl:hasAbstract "Not in BHB!  notes from Catalog by Chaim Meiselman:  General Note  Printers device at the bottom of leaf 2.  General Note  Approbation of Naphtali ha-kohen Katz (1649-1718) of Frankfurt, dated Tuesday 8 Tevet 1710, repeating that the author is a man of faith who didn't study the sciences with heretics or apostates, and he is trustworthy, for 'he arrived at these conclusions by his independent intellect' - מה שאסף לבית הדפוס למד לפי שכלו. Additional approbations from Samuel ha-kohen Schotten of Darmstadt, dated Friday, parashat Vayigash, 1710; and Hirsch Spitz Segal of Worms, dated Thursday 10 Tevet 1710.  Citation/Ref. Note    Friedberg, Beit Eked Sefarim,   3012.  General Note  Only printing.  Citation/Ref. Note    Zedner Cat. Heb. Books Lib. BM   p. 278: Heide, Moses ben Joseph.  Citation/Ref. Note    Steinschneider, Cat. Libr. Bodl.,   6493 : 1.  General Note  L. 159 : 'fun vexl audr vert dere in dizn bukh : far falndr mints : mas : gvikht tsahl aunz tseyt ahrtn'. Trans. Exchange rates in this book : for finer currencies and measures will be printed in a future time." ;
    dc:contributor "http://data.judaicalink.org/data/footprints/51846c11-07de-5361-955c-272901fae413",
        "http://data.judaicalink.org/data/footprints/b7d070ed-729a-524c-b271-f603b6d723fd",
        "http://data.judaicalink.org/data/footprints/da406289-cd9e-5aa1-8a7b-890a002eb09e" ;
    dc:title "Maʻaśeh ḥoresh ṿe-ḥoshev" ;
    dcterms:created "2024-03-17T17:10:43.254829"^^xsd:dateTime ;
    skos:prefLabel "Maʻaśeh ḥoresh ṿe-ḥoshev" .

