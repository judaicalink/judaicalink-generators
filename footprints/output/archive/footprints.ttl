<http://data.judaicalink.org/data/footprints/5001cda8-76e2-5608-aa09-7ff5442b68ff> a gndo:Work ;
    gndo:associatedPlace "Darn Firmed",
        "דיהרן פארט" ;
    gndo:author "http://data.judaicalink.org/data/footprints/226d22a5-ef18-532c-a195-03531688aa9e",
        "http://data.judaicalink.org/data/footprints/c96b92a6-1ee5-58cf-8fc9-1765fabc2619" ;
    gndo:dateOfPublication "1733" ;
    gndo:formerOwner "Avraham A. Price",
        "Eliezer ben Efraim(?)",
        "Shmuel",
        "The Thomas Fisher Rare Book Library, University of Toronto",
        "Yehuda Leib ben Efraim Segal" ;
    gndo:language "Hebrew" ;
    gndo:owner "The Thomas Fisher Rare Book Library, University of Toronto" ;
    gndo:printer "http://data.judaicalink.org/data/footprints/f6adb9f4-28ce-5ffb-89f1-eb56bb044c39" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000110481&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0" ;
    jl:hasAbstract "Subtitle: שאלות ותשובות וחידושים וביאורים. חלק ראשון מחבוריו שחיבר ... ר' אליקום געץ זלהה בן ... ר' מאיר ... שהרביץ תורה בכמה קהלות קדושות במדינות אשכנז ופולין והיה נקרא אבד מהילדסים. ועתה התעורר בנו ... ר' מאיר נרו אבד ... לאסק ובקק פיעטרקוב וסביבותי', להדפיס ספר הלז. ולפי הנראה בהסכמות מה שנתנו ... להרב ... המחבר ... נקרא הספר אבן השהם, אכן מחמת הני עתים לרעה שהי' במדינות פולין והיה ארץ משובשת בגייסות ותמיד ברחנו מחמת נפשות ומחמת ממון, נאבדו כמה וכמה כתבים מחבוריו ונאבד גם הקדמת המחבר הנל ולא נתוודע מדוע לקרא אותו אבן השוהם. ונקרא אותו עכשיו בנו הנל ספר מאירת עינים באומרו ששמו מרומז בתוכו ...<br />BHB note: דף [3, א- 5, א]: הקדמת בן המחבר, עורך הספר, ר' מאיר." ;
    dc:title "Sefer Even ha-shoham u-Meʼirat ʻenayim" ;
    dcterms:created "2024-03-17T21:12:02.417660"^^xsd:dateTime ;
    skos:prefLabel "Sefer Even ha-shoham u-Meʼirat ʻenayim" .

