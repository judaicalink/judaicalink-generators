    gndo:printer "http://data.judaicalink.org/data/footprints/31024910-3ef1-550d-82c7-971ab191dac3",
        "http://data.judaicalink.org/data/footprints/63925f45-10a8-54da-a4ed-023f8a4bbba5" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000317275&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000318773&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000328504&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000333273&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000333345&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000333894&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000334101&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000334221&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,328504&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0" ;
    jl:hasAbstract "",
        "<p>There is no title page but from the looks of the pages it seems that it was printed in Bomberg's first printing of the Talmud.</p>",
        "Berlin and Frankfurt on der Oder",
        "The title page reads that this is an edition of Bava Kama and that it was part of the second printed edition of the Talmud printed by Daniel Bomberg in Venice. According to the NLI record for Bava Kama, Bava Kama was printed for a second time  in 1538, making it part of the third printing. :  http://primo.nli.org.il/primo_library/libweb/action/dlDisplay.do?vid=NLI&docId=NNL_ALEPH002107794 Note that Avraham Rosenthal and Rabbinovicz discuss that the title pages of volumes printed in the third printing were forged and that we cannot always follow what is written on the title pages of Bomberg Talmuds printed as part of the second and third printings. See Avraham Rosenthal, “Daniel Bomberg and His Talmud Editions,” Gli Ebrei e Venezia, ed. Gaetano Cozi (Milan: Edizioni di Communita, 1987), pp. 391-392 and his footnotes there." ;
    dc:publisher "http://data.judaicalink.org/data/footprints/170e16ea-060d-5fb4-bf58-6758c110c5eb",
        "http://data.judaicalink.org/data/footprints/1818b22e-b8e3-5e80-9b23-9362f19dacde" ;
    dc:title "Talmud. Bava Kamma" ;
    dcterms:created "2024-03-18T00:49:03.157527"^^xsd:dateTime ;
    skos:prefLabel "Talmud. Bava Kamma" .

