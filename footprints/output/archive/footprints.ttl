<http://data.judaicalink.org/data/footprints/5f3c2a56-843d-513f-b6a8-26e3464999c7> a gndo:Work ;
    gndo:associatedPlace "Francofurti ad Moenum",
        "Frankfurt to Main" ;
    gndo:author "http://data.judaicalink.org/data/footprints/5e08b947-dff7-56dc-a95f-8095c8d6226d" ;
    gndo:compiler "http://data.judaicalink.org/data/footprints/f011b071-f004-56ff-a2c6-4492351b5e8e" ;
    gndo:dateOfPublication "1689" ;
    gndo:formerOwner "Arthur Teller, M.D.",
        "Ezekiel Leavitt",
        "University of Pennsylvania Libraries" ;
    gndo:language "Dutch",
        "German",
        "Greek",
        "Hebrew",
        "Latin" ;
    gndo:printer "http://data.judaicalink.org/data/footprints/5f167f62-4d4b-563b-80c7-e7e392d3ad54" ;
    jl:describedAt "https://search.worldcat.org/de/title/83220140" ;
    jl:hasAbstract "description from Kestenbaum & co. Auction:  Johannes Cocceius [Coch] (1603-1669) served as Professor of Theology at Leiden, a position he held from 1650 until his death. Katchen credits him with being the first Dutch Hebraist who can truly be called a rabbinic scholar. Remarkably, this dictionary of Hebrew and Aramaic, as per all Coch’s works, is free of Christian polemics. For this reason, it was necessary, after Coch’s death, for his son to defend him against the charge that he had overindulged in “Jewish-talmudic exegesis.” See Aaron L. Katchen, Christian Hebraists and Dutch Rabbis (1984) pp. 65-75; EJ, Vol. VIII, col. 42." ;
    dc:title "Lexicon (Johannes Cocceius)" ;
    dcterms:created "2024-03-17T17:02:09.771089"^^xsd:dateTime ;
    skos:prefLabel "Lexicon (Johannes Cocceius)" .

