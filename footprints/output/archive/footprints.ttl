<http://data.judaicalink.org/data/footprints/60073783-f518-5e88-a755-de0fc4a20a98> a gndo:Work ;
    gndo:associatedPlace "Amsterdam",
        "אמשטרדם" ;
    gndo:author "http://data.judaicalink.org/data/footprints/48b7b214-1f6b-5313-9fe5-bb349133f775" ;
    gndo:dateOfPublication "1709",
        "1767" ;
    gndo:formerOwner "Baltimore Hebrew College",
        "Joseph Meyerhoff Collection, Towson University Library",
        "Russian State Library",
        "Yosef Yitzhak Schneerson (Sixth Lubavicher Rebbe)" ;
    gndo:language "Hebrew" ;
    gndo:owner "Joseph Meyerhoff Collection, Towson University Library",
        "Russian State Library" ;
    gndo:printer "http://data.judaicalink.org/data/footprints/171ce4e1-cfee-5863-9a0c-db4a8a7dcd0c",
        "http://data.judaicalink.org/data/footprints/5cce52b4-c2da-59d4-9d38-51d91bfdfdfb",
        "http://data.judaicalink.org/data/footprints/ec1cf156-17c6-585d-b1f1-aa438588dc2b" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000170543&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000170545&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://search.worldcat.org/de/title/52467253" ;
    jl:hasAbstract "All notes by Chaim Meiselman:  This is the third printing of the sermons and homiletical material by Shelomoh-Efraim Lentschütz (after the German name for the town of Łęczyca - in the Łódź greater area - where the author was born), who was a prominent rabbinical figure who served the Prague Rabbinate 1604 until his death. He published a number of Halakhic works and also homiletical material; this volume is the most prominent of the author’s books.     The volume was printed in Amsterdam by Jacob Alvarez-Soto, Moses ibn Jakar Brandon, and Benjamin de Juenche (likely a derivative of the surname Juncke or Juncker, which was also derived from Juncherre, or ’young nobleman’ in Middle High German).      Ornamentation throughout; many with images of cherubic faces.   references    Friedberg, B. Bet eked sefarim, v.2 p. 466 #268 no. 3      BM Hebrew, p. 240      Jewish Encycl., v.5 p. 192      Steinschneider, M. Cat. Libr. Hebr. Bodl., #4808 :5" ;
    dc:title "Keli yakar" ;
    dcterms:created "2024-03-17T16:28:10.129526"^^xsd:dateTime ;
    skos:prefLabel "Keli yakar" .

