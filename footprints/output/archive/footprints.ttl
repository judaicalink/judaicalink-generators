<http://data.judaicalink.org/data/footprints/cd6af259-4799-50c3-b4f2-7dd00bb2a30d> a gndo:Work ;
    gndo:associatedPlace "Costantine",
        "קוסטנטינא" ;
    gndo:author "http://data.judaicalink.org/data/footprints/1bdfb1b4-9469-5d63-8375-e049a2a78362" ;
    gndo:compiler "http://data.judaicalink.org/data/footprints/69406905-496d-5944-a0c4-b8b35d26291c" ;
    gndo:dateOfPublication "1737" ;
    gndo:dedicatee "http://data.judaicalink.org/data/footprints/391aab9d-8a03-5c0f-9a60-7d2be3932a9c" ;
    gndo:formerOwner "Chaim Meiselman",
        "Eli'ezer de Toldo",
        "Hebrew Theological College (Chicago)" ;
    gndo:language "Hebrew" ;
    gndo:owner "Chaim Meiselman" ;
    gndo:printer "http://data.judaicalink.org/data/footprints/100e69f1-25ae-58af-9ffe-a5ba57cc13da" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000156431&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0" ;
    jl:hasAbstract "The first edition of the novellae on Maimonides by R. David Falkon called 'Bene David'. Included herein are responsa by other Rabbinic authorities in Constantinople during the author's rabbinate there during the 17th century.  The author's widow brought the volume to print.  Included are the Kuntros ha-Sivlonot (קונטרס סבלונות) regarding dowry and ownership of respective properties of husband and wife, and Kuntros 'Igunnta de-Ittsa about Agunot. As such, portions of the volume focus on Even ha-'Ezer.  Author and imprint cited in Heyd, Uriel, The Jewish Communities of Istanbul in the Seventeenth Century in Oriens, Vol. 6, No. 2 (Dec. 31, 1953), p. 313." ;
    dc:title "Bene David" ;
    dcterms:created "2024-03-17T12:26:50.351387"^^xsd:dateTime ;
    skos:prefLabel "Bene David" .

