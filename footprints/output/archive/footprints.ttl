<http://data.judaicalink.org/data/footprints/27822fa0-ce40-5bac-bbf8-ff2835dfef9f> a gndo:Work ;
    gndo:associatedPlace "Amsterdam" ;
    gndo:author "http://data.judaicalink.org/data/footprints/dc7b226b-56ef-56b5-9aea-3bbc5655a8b9" ;
    gndo:dateOfPublication "1763" ;
    gndo:language "Hebrew" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000307562&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0" ;
    jl:hasAbstract "Abraham Monteil, editor of this prayer book, was a native of L’Isle-sur-la-Sorgue, smallest of “the four holy communities” of Comtat Venaissin, the papal territory in Southern France that historically provided a safe haven for Jews fleeing the provinces of Languedoc and Provence, from whence they were expelled by the French monarchs. (The other three communities were: Avignon, Carpentras, and Cavaillon.) The Jews of the Comtat had their own synagogue rite, which Cecil Roth notes to be “of very considerable historical and literary interest.” See C. Roth, “The Liturgy of Avignon and the Comtat Venaissin,” Journal of Jewish Bibliography I (1939) p. 99-105." ;
    dc:publisher "http://data.judaicalink.org/data/footprints/89dade54-7d9f-5d6f-b10b-0628a9fd197c" ;
    dc:title "Seder Ha’Ashmaroth MeRosh Chodesh Elul Ve’Asereth Yemei Teshuvah" ;
    dcterms:created "2024-03-17T21:00:05.945465"^^xsd:dateTime ;
    skos:prefLabel "Seder Ha’Ashmaroth MeRosh Chodesh Elul Ve’Asereth Yemei Teshuvah" .

