        "1645",
        "1735" ;
    gndo:formerOwner "Alice Parker Lesser",
        "Beinecke Rare Book and Manuscript Library, Yale University",
        "C. F. Libbie Bookdealers",
        "Josephus Mona Lesser" ;
    gndo:language "Aramaic",
        "Hebrew" ;
    gndo:owner "Beinecke Rare Book and Manuscript Library, Yale University",
        "Josephus Mona Lesser" ;
    gndo:printer "http://data.judaicalink.org/data/footprints/63925f45-10a8-54da-a4ed-023f8a4bbba5" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000308265&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000334101&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000334234&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0" ;
    jl:hasAbstract "",
        "This volume is odd in the sense that the title page offers more information on it then I have seen thus far. It states that this book not only has the commentary of Rambam, which is stated first because it appears at the beginning of the volume, but included on the title page is a specific date of publication--the 3rd day of Tishrei, 1522--and also that this is the first year of the Doge, Antonio Grimani's, reign in Venice. The title page hopes that this Doge will lead them to peace as the Republic was then involved in the Italian war." ;
    dc:title "Talmud Yerushalmi. Shekalim" ;
    dcterms:created "2024-03-18T01:13:52.252146"^^xsd:dateTime ;
    skos:prefLabel "Talmud Yerushalmi. Shekalim" .

