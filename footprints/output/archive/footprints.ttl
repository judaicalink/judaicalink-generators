<http://data.judaicalink.org/data/footprints/147cc3f1-bebe-5bb3-8920-4beeaedfa219> a gndo:Work ;
    gndo:associatedPlace "Kindenton",
        "קושטנדינא" ;
    gndo:author "http://data.judaicalink.org/data/footprints/7e32fdf8-31e8-5974-b0d2-acc9df3aca32",
        "http://data.judaicalink.org/data/footprints/cc310c68-ebf7-5eba-8b0d-15a4287af3e0" ;
    gndo:dateOfPublication "1739" ;
    gndo:formerOwner "Menahem Joseph Chai Zeevist",
        "Russian State Library" ;
    gndo:language "Hebrew" ;
    gndo:owner "Russian State Library" ;
    gndo:printer "http://data.judaicalink.org/data/footprints/97ea35ee-b7cb-5165-ac8b-b699d56c7aba" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000125758&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0" ;
    jl:hasAbstract "Subtitle: ... חדושים ... על התורה הן מפי עצמו הן מפי אחרים ... חברו ... ר' יאודה דיוואן נרו. ובסוף הספר קונטריס משות מאשר נשאל הרב הנז' ומה שנשא ונתן עם רבנן תקיפי ארעא דישראל ...<br />BHB note: לא דף: שאלות ותשובות להרב המחבר. כולל גם: תשובות של חותנו ר' יעקב בר דוד הכהן [רפאפורט] (דף א; ה,ב-ט,א; כא,ב-כט,ב); תשובה של ר' משה חיון (דף ה); תשובה של ר' משה בר יהונתן גאלנטי (דף ל-לא); נוסח הסכמת רבני וגאוני עהק ירושלם, משנת תנד, בעניין פרעון כתובת אלמנה (דף כט,ב-ל,א); להיות דבחדש מנחם שנת התפח הלכתי בשליחותיהו דרבנן ... לעיר ברוסא ... ושם הראני נכדו של ... כמוהרש [ר' שלמה] סאגיס זלהה ספר כתיבות מהרב הנז' ושם ראיתי על ענין התרנגולות הטיפיליש ... ולמען יעמוד ימים רבים העליתי אותו בקן קולמוסא (דף ב,א)." ;
    dc:title "Sefer Chut ha-meshulash" ;
    dcterms:created "2024-03-17T21:08:55.472134"^^xsd:dateTime ;
    skos:prefLabel "Sefer Chut ha-meshulash" .

