        "אמשטרדם",
        "וויניציאה" ;
    gndo:author "http://data.judaicalink.org/data/footprints/e0045b7d-b19f-5d21-a2cc-c030c3c74135" ;
    gndo:dateOfPublication "1578",
        "1662",
        "1761",
