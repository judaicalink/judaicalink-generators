<http://data.judaicalink.org/data/footprints/e8cb1377-f5fd-5d9c-af5b-52c44c51d1b5> a gndo:Work ;
    gndo:associatedPlace "Prague",
        "פראג" ;
    gndo:dateOfPublication "1720" ;
    gndo:ditor "http://data.judaicalink.org/data/footprints/097fd22e-5e9c-519a-8486-8d5713e90e8c" ;
    gndo:language "German",
        "Hebrew" ;
    jl:describedAt "https://search.worldcat.org/de/title/966001429" ;
    jl:hasAbstract "For the most part, it was Protestant theologians and missionaries who made use of Yiddish in their efforts to missionize amongst the Jews in the early modern period. The present volume is a rare example of a Catholic attempt to make the words of Christian prayer accessible to the newly converted. This first edition used square Hebrew characters, presented opposite the German text. By the time a second edition appeared in 1755, the entire work, save for the title page, was printed in waybertaytsh." ;
    dc:title "Christian Prayerbook" ;
    dcterms:created "2024-03-17T14:31:59.542969"^^xsd:dateTime ;
    skos:prefLabel "Christian Prayerbook" .

