<http://data.judaicalink.org/data/footprints/157bbd29-5096-599a-80fe-abe419eaa0aa> a gndo:Work ;
    gndo:associatedPlace "Winigat",
        "וויניציאה" ;
    gndo:author "http://data.judaicalink.org/data/footprints/1655487b-a3a9-5599-994d-d0b9342fe90d" ;
    gndo:dateOfPublication "1522",
        "1545",
        "1567" ;
    gndo:formerOwner " Zalman Schnur b. Samuel Böenft ha-levi Schnur",
        "Annenberg Research Institute",
        "Baltimore Hebrew College",
        "Bodleian Library, Oxford",
        "Columbia University Libraries",
        "Eleazar b. Shimon Aharon",
        "Joseph Meyerhoff Collection, Towson University Library",
        "Moses Engelmann (Warsaw)",
        "Moses ben Issachar Reitlieker",
        "Moshe ha-Levi",
        "National Library of Israel",
        "Owner of Abraham Saba Biur signing in Greek",
        "P. Mendelsohn",
        "Shmu'el Böenft Shnur  (Fürth)",
        "Temple Emanu-el",
