<http://data.judaicalink.org/data/footprints/656a92cf-6bf5-5603-8526-ea92785351d1> a gndo:Work ;
    gndo:associatedPlace "Lviv",
        "Wandsbek - Hamburg",
        "Zhovkva" ;
    gndo:author "http://data.judaicalink.org/data/footprints/8351bc61-f94f-5685-bbb0-2b48503f1fc9" ;
    gndo:dateOfPublication "1729",
        "1755",
        "1811" ;
    gndo:formerOwner "Baltimore Hebrew College",
        "Beit Hamidrash Meittes (Vilnius)",
        "Joseph Meyerhoff Collection, Towson University Library",
        "Russian State Library",
        "Sa'adat Bahurim Society, Amsterdam",
        "Shimeon Brisman",
        "Shmuel Zanvill Segel (Samuel Levy), of Balbronn",
        "Washington University at St. Louis",
        "Yeshiva Tomchei Temimim Lubavich - Vilna" ;
    gndo:language "Hebrew" ;
    gndo:owner "Joseph Meyerhoff Collection, Towson University Library",
        "Russian State Library",
        "Shmuel Zanvill Segel (Samuel Levy), of Balbronn",
        "Washington University at St. Louis" ;
    gndo:printer "http://data.judaicalink.org/data/footprints/67139da1-64c4-558e-b3a1-8ae0ac28c9f7" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000169140&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000180670&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000180671&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0" ;
    jl:hasAbstract "",
        "All notes by Chaim Meiselman:   notes    These are the printed elements of notes composed of the learning of The Order of Kodashim with the commentary of the Tosafot. Many of the notes are no longer than a sentence, and they serve to correct the errors in the text of the Talmud (Ta’ut Sofrim) which are particularly acute for the order of Kodashim. When the note appears to be a paragraph in length, its purpose is to elucidate passages.      Printed in double columns, with mini script and bold headings. The introduction contains elements of ornamentation around the text-block.      Haskamot and introduction are copied from the first edition, printed at Wandsbek 1728-1729. Haskamah of Ezekiel Katzenellenbogen of the Tripartite Communities (Altona, Hamburg, and Wandsbek), dated 7 Kislev 1728; Yosef-Meir of Hanover, documenting that he is the nephew of R. Ozer, the son of the author, who had recently died in Jerusalem, 2 Tamuz 1729; for Menahem-Mendel Ashkenazi of Worms, signing in Sivan 1728; Samuel Hillmann in Mannheim, Nisan 1728.      T.p. with architectural border. Hidden within the architechtural scheme are signs from the symbols of the Zodiac: Leo and Gemini together at the bottom, with Cancer at the header." ;
    dc:publisher "http://data.judaicalink.org/data/footprints/b267e0d5-c251-570e-bb4c-6be6270c1dcb",
        "http://data.judaicalink.org/data/footprints/d0065c7d-3d8b-522e-b3ca-20532d0eec50" ;
    dc:title "Tson Kodashim" ;
    dcterms:created "2024-03-18T02:10:11.236426"^^xsd:dateTime ;
    skos:prefLabel "Tson Kodashim" .

