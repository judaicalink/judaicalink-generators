        "http://data.judaicalink.org/data/footprints/ee6a990b-815e-59c1-93c5-50d3e86b84cc" ;
    dc:publisher "http://data.judaicalink.org/data/footprints/c9b3c84b-9f26-5119-88e5-76fa191b88bf" ;
    dc:title "Eshle ravreve" ;
    dcterms:created "2024-03-17T15:02:17.499149"^^xsd:dateTime ;
    skos:prefLabel "Eshle ravreve" .

