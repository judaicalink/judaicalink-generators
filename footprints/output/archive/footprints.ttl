<http://data.judaicalink.org/data/footprints/982f5bfe-0f73-5070-bab0-75daef12fe54> a gndo:Work ;
    gndo:associatedPlace "Istanbul",
        "Mantova",
        "Mantua" ;
    gndo:author "http://data.judaicalink.org/data/footprints/539692ba-3a9d-5a35-b206-3cce14f07415" ;
    gndo:dateOfPublication "1514" ;
