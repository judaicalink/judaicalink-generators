<http://data.judaicalink.org/data/footprints/52369bd4-d768-5ec1-907b-b637d5f6a4b6> a gndo:Work ;
    gndo:associatedPlace "Frankfurt am Main" ;
    gndo:author "http://data.judaicalink.org/data/footprints/f966f080-e24f-50d8-9201-d296a740e6b5" ;
    gndo:dateOfPublication "1651 - 1652" ;
    gndo:formerOwner "Chaim Meiselman" ;
    gndo:language "Aramaic",
        "Hebrew" ;
    gndo:owner "Chaim Meiselman" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000121806&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0" ;
    jl:hasAbstract "this imprint seems to be a lacuna in the German-Hebraica bibliography; it is dated 1652, the same year which it was printed supplementing the printing of Yalkut hadash in Prague. From the introduction it appears that this was printed before that; unclear as to why.   From the ornaments it is pretty clear that this wasn't printed in Hanau; the imprint may be missing because of it printed in Frankfurt am Main. Does this make it the first Hebrew book printed in Frankfurt?" ;
    dc:title "Shikhat leket" ;
    dcterms:created "2024-03-17T23:32:08.837250"^^xsd:dateTime ;
    skos:prefLabel "Shikhat leket" .

