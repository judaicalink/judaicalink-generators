<http://data.judaicalink.org/data/footprints/05a3c803-6896-5525-840d-4154d1b32512> a gndo:Work ;
    gndo:associatedPlace "Basel" ;
    gndo:author "http://data.judaicalink.org/data/footprints/73e95e10-6663-5dd7-b2f0-0f45737dd16b" ;
    gndo:dateOfPublication "1639" ;
    gndo:formerOwner "Jewish Public Library, Baltimore",
        "John Jackson (d. 1724)",
        "Joseph Meyerhoff Collection, Towson University Library",
        "Magdalene College Library, Cambridge",
        "Samuel Pepys" ;
    gndo:language "Latin" ;
    gndo:owner "Joseph Meyerhoff Collection, Towson University Library",
        "Magdalene College Library, Cambridge" ;
    gndo:printer "http://data.judaicalink.org/data/footprints/fd9b53a8-102f-53a9-b847-c0f190871ef9" ;
    jl:describedAt "https://search.worldcat.org/de/title/557708479" ;
    jl:hasAbstract "All notes by Chaim Meiselman:  notes    Added t.p., engraved.      This is the second edition of the Lexicon-Dictionary of the Chaldaic-Talmudic-Rabbinic literature by Johann Buxtorf the Elder. It expands upon the first edition (Basel 1613) and includes emendations and additions by Johann Buxtorf the Younger.      Full-folio illustrated half-title facing the title. Two miniatures, one with Abraham’s tree (Eshel) and the other with a burning Sodom flanking a crown-miniature of the Tower of Babel; Daniel (holding a panel with roaring lions) and Ezra holding a bound volume; a miniature of Solomon consecrating the Temple is below.      Printed in double-column Latin-Hebrew-Aramaic passages; fonts regulate between italics and bold, and vowelized and unvowelized (Nikud). With indices and an introduction." ;
    dc:title "Lexicon chaldaicum talmudicum et rabbinicum" ;
    dcterms:created "2024-03-17T17:01:28.538506"^^xsd:dateTime ;
    skos:prefLabel "Lexicon chaldaicum talmudicum et rabbinicum" .

