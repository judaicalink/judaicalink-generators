    gndo:author "http://data.judaicalink.org/data/footprints/021e4458-217e-59b8-a9e6-c73b4434a5f9",
        "http://data.judaicalink.org/data/footprints/c3874879-5036-597a-ae64-100566533f7a" ;
    gndo:dateOfPublication "1691",
        "1692",
        "1768" ;
    gndo:formerOwner "Archbishop Marsh's Library",
        "Baltimore Hebrew College",
        "Eliezer Lipman ben Moshe",
        "Joseph Meyerhoff Collection, Towson University Library",
        "Marsh, Narcissus, 1638-1713",
