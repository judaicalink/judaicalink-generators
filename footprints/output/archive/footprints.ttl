    gndo:printer "http://data.judaicalink.org/data/footprints/31024910-3ef1-550d-82c7-971ab191dac3",
        "http://data.judaicalink.org/data/footprints/63925f45-10a8-54da-a4ed-023f8a4bbba5",
        "http://data.judaicalink.org/data/footprints/d0422f66-bc4c-5c27-b72e-3614f08e9f6f" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000151109&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
