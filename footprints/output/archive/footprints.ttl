    gndo:printer "http://data.judaicalink.org/data/footprints/11fcd91d-8cc5-571a-aedc-20fceac142d5",
        "http://data.judaicalink.org/data/footprints/31024910-3ef1-550d-82c7-971ab191dac3",
        "http://data.judaicalink.org/data/footprints/f0ce6774-0fa1-5251-a01d-a03378f5bcf2" ;
    jl:describedAt "https://data.cerl.org/istc/id00101800",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000105180&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000105181&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000105182&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
