    gndo:language "Spanish" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,057442023&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0" ;
    jl:hasAbstract "In two dissertations at the conclusion of the work the author discusses the present whereabouts of the Ten Lost Tribes. In doing so, he draws upon Menasseh ben Israel’s testimony (based upon the deathbed evidence of Antonio Montezinos) of the sighting of remnants of the tribe of Reuben in present-day Ecuador (pp. 376-7). The Spanish historian also cites the testimony of the famous interloper Eldad the Danite and the likelihood that the exiled tribe of Dan took up residence in Ethiopia (p. 380)." ;
    dc:title "Monarchia Hebrea" ;
    dcterms:created "2024-03-17T19:46:35.085945"^^xsd:dateTime ;
    skos:prefLabel "Monarchia Hebrea" .

