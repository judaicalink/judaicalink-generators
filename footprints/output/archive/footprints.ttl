<http://data.judaicalink.org/data/footprints/b1f80cc4-d640-53cd-a35a-7a8831016307> a gndo:Work ;
    gndo:associatedPlace "Liuro",
        "ליוורנו" ;
    gndo:author "http://data.judaicalink.org/data/footprints/19fdbb56-a498-5f0b-a781-7f9cadf65084" ;
    gndo:dateOfPublication "1767" ;
    gndo:ditor "http://data.judaicalink.org/data/footprints/7a0f1f4c-3aa0-531d-8845-650f502c67b1" ;
    gndo:formerOwner "Baltimore Hebrew College",
        "Joseph Meyerhoff Collection, Towson University Library",
        "Yeshiva of Volozhin" ;
    gndo:language "Hebrew" ;
    gndo:owner "Joseph Meyerhoff Collection, Towson University Library" ;
    gndo:printer "http://data.judaicalink.org/data/footprints/f51355ae-1f2a-5378-85e0-b3843ead1b2d" ;
    gndo:sponsorOrPatron "http://data.judaicalink.org/data/footprints/11eb5125-76d8-5743-b5da-8c2e57f49f1e" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000148394&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0" ;
    jl:hasAbstract "All notes by Chaim Meiselman:  notes    This is the first printing of the volume Yad Malakhi by R. Malachi b. Ya’akov Hakohen, also of Livorno. The work was highly acclaimed as setting a methodology for Talmud and Halakha study, and was accepted by many of the pre-eminent Talmudists and Halakhists of the nineteenth century.      This printing is that of Livorno in 1766-7 (chronogram בשנת ת’ב’ע’נ’ה’ שפתי תהלה לפק) by Moses Attias. The editor was Moses-Ḥai Melol, who writes an end-note. The patron of the volume was Yissakhar Abulafia, also of Livorno, who writes an introduction and signs in December-January 1766-7 (לסדר לישועתך קויתי ה’ - Parashat Vayeḥi.)   references    Steinschneider, M. Cat. librorum hebraeorum, #6202      Jewish Encycl., v.8, p.276      BM Hebrew, p. 507" ;
    dc:title "Yad Malakhi" ;
    dcterms:created "2024-03-18T02:17:58.010411"^^xsd:dateTime ;
    skos:prefLabel "Yad Malakhi" .

