        "http://data.judaicalink.org/data/footprints/95f9cd3a-e736-5c13-8678-3f974f7f5182" ;
    dc:publisher "http://data.judaicalink.org/data/footprints/3db9325d-8504-56fb-8147-c98b784891b0",
        "http://data.judaicalink.org/data/footprints/8170795a-e179-52eb-a7c4-1feb3b56512d" ;
