    gndo:printer "http://data.judaicalink.org/data/footprints/25a3711d-546a-5760-9d76-48602db4e5c4",
        "http://data.judaicalink.org/data/footprints/4f9a4202-3e19-5215-afef-13a6eb29b4ad" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000109742&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0",
        "https://search.worldcat.org/de/title/122810668" ;
    jl:hasAbstract "Includes Hilkhot Nidah of Rabbi Yosef Karo's Shulḥan ʻarukh, with the annotations and preface of Rabbi Moshe Isserles.",
        "Zot Torat ha-Hatat is the work of Moshe ben Israel Isserles (1525/30-1572), a polish rabbi and codifier. This work focuses on the laws of forbidden matters (issur ve-heter) and is a reworking of an earlier work by Isaac ben Meir of Dueren, Sha'arei Dura. This imprint also includes Hilkhot (the laws of) Niddah written by Joseph ben Ephraim Karo along with the Hagahot (notes) of Isserles." ;
    dc:title "Zot Torat ha-Hatat" ;
    dcterms:created "2024-03-18T02:48:01.697868"^^xsd:dateTime ;
    skos:prefLabel "Zot Torat ha-Hatat" .

