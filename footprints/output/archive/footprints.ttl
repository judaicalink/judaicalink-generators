<http://data.judaicalink.org/data/footprints/2bd14bb6-58d7-598e-8a9e-403f8e8ec8ef> a gndo:Work ;
    gndo:associatedPlace "Wandsbek - Hamburg" ;
    gndo:author "http://data.judaicalink.org/data/footprints/10176d7c-8248-55d9-a6b0-ab5f3528012f",
        "http://data.judaicalink.org/data/footprints/af0460a5-7851-5700-8834-dd3f29acc7dd" ;
    gndo:dateOfPublication "1726" ;
    gndo:formerOwner "Baltimore Hebrew College",
        "Convent de Sant Joseph",
        "Convent de St. Joan de Jerusalem",
        "Joseph Meyerhoff Collection, Towson University Library",
        "University of Barcelona" ;
    gndo:language "Hebrew" ;
    gndo:owner "Joseph Meyerhoff Collection, Towson University Library",
        "University of Barcelona" ;
    gndo:printer "http://data.judaicalink.org/data/footprints/5b3e5dd4-4668-5ab7-95a1-73d235b2c1f1" ;
    jl:describedAt "https://merhav.nli.org.il/primo-explore/search?query=any,contains,000132807&tab=default_tab&search_scope=Local&vid=NLI&lang=en_US&offset=0" ;
    jl:hasAbstract "",
        "<p>Notes by Chaim Meiselman: This volume (Leḳeṭ ha-ḳemaḥ) is Moses Hagiz's commentary to select passages in the Mishnah; it is the first printing, not to be confused with the commentary of the Shulhan Arukh by the author with the same title. The author was a Jerusalemite and a rabbinical figure in the Tripartite Communities (שלש קהלות אהו) of Altona, Hamburg, and Wandsbek in Germany. Ending the volume is a mini-treatise on ethics by the author, and the ethical will of the author's father - Jacob Hagiz - called 'Zikaron le-Bene Yisra'el', who died in 1674. (Leḳeṭ ha-ḳemah) Steinschneider, M. Cat. librorum hebraeorum,#6447 no. 11. Friedberg, B. Bet eked sefarim, v.3 p. 716, #202</p>" ;
    dc:publisher "http://data.judaicalink.org/data/footprints/65349ff2-18a6-53e5-86ef-f9f1ec35c0f9" ;
    dc:title "Leket ha-kemah" ;
    dcterms:created "2024-03-17T16:55:20.204228"^^xsd:dateTime ;
    skos:prefLabel "Leket ha-kemah" .

