<http://data.judaicalink.org/data/hhkeydocs/Conrad_Konig> a foaf:Person ;
    gndo:gndIdentifier "1037496469" ;
    jl:birthDate "1693" ;
    jl:birthLocation <http://data.judaicalink.org/data/hhkeydocs/Hamburg> ;
    jl:deathDate "1757-03-02" ;
    jl:describedAt <https://schluesseldokumente.net/person/gnd/1037496469.jsonld> ;
    jl:hasAbstract "wurde am 13.8.1723 als Nachfolger von Konrad Neumann Ratsdrucker (bis 1757); sein Nachfolger in diesem Amt wurde Jeremias Konrad Piscator. König wirkte nicht nur als Drucker, sondern auch - von 1728 bis 1734 in Gemeinschaft mit Gottfried Richter - als Buchhändler und Verleger; seine Witwe betrieb das Geschäft zunächst allein, später zusammen mit ihrem Sohn Cornelius Conrad (gest. 1771) weiter" ;
    dcterms:created "2025-11-20T14:47:58.707160"^^xsd:dateTime ;
    owl:sameAs <https://viaf.org/viaf/http://viaf.org/viaf/42171326/> ;
