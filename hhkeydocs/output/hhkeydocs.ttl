    jl:hasAbstract "Ingeborg Grolle, Dr. phil., *1931, arbeitete beim Südwestdeutschen Rundfunk, sowie an Veröffentlichungen zur Sozialgeschichte Hamburgs. Forschungsschwerpunkt: Biografien, Frauen- und Sozialgeschichte." ;
    dcterms:created "2025-11-20T14:52:47.654094"^^xsd:dateTime ;
