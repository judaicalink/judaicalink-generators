<http://data.judaicalink.org/data/hhkeydocs/Dirk_Brietzke> a foaf:Person ;
    gndo:gndIdentifier "121234541" ;
    jl:birthDate "1964-10-14" ;
    jl:birthLocation <http://data.judaicalink.org/data/hhkeydocs/Geesthacht> ;
    jl:describedAt <https://schluesseldokumente.net/person/gnd/121234541.jsonld> ;
    jl:hasAbstract "Dirk Brietzke, Dr. phil., geb. 1964, ist wissenschaftlicher Mitarbeiter an der Arbeitsstelle für Hamburgische Geschichte der Universität Hamburg. Seine Forschungsschwerpunkte sind: Sozial- und Kulturgeschichte der Frühen Neuzeit,  Bürgertumsforschung des 18. und 19. Jahrhunderts,    Geschichte des Armenwesens, Geschichtstheorie,     Hamburgische und norddeutsche Regionalgeschichte." ;
    dcterms:created "2025-11-20T14:52:38.750528"^^xsd:dateTime ;
    owl:sameAs <https://viaf.org/viaf/http://viaf.org/viaf/35306914/> ;
