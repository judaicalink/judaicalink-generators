<http://data.judaicalink.org/data/hhkeydocs/Nadine_Garling> a foaf:Person ;
    gndo:gndIdentifier "1141916487" ;
    jl:birthDate "1980" ;
    jl:describedAt <https://schluesseldokumente.net/person/gnd/1141916487.jsonld> ;
    jl:hasAbstract "Nadine Garling, M.A., geb. 1980, ist Doktorandin im Fach Mittlere und Neuere Geschichte an der Universität Hamburg. Ihr Promotionsprojekt befasst sich mit der Geschichte der Israelitischen Gemeinde Lübeck im späten 19. und frühen 20. Jahrhundert. Zuvor arbeitete sie am Jüdischen Museum Berlin. Ihre Forschungsinteressen liegen auf dem Gebiet der deutsch-jüdischen Geschichte im 19. und frühen 20. Jahrhundert, vor allem in Bezug auf die religiöse Ausdifferenzierung, sowie die Geschichte jüdischer Gemeinden in Norddeutschland und die Entwicklung des deutschen Zionismus." ;
    dcterms:created "2025-11-20T14:48:35.242478"^^xsd:dateTime ;
    owl:sameAs <https://viaf.org/viaf/http://viaf.org/viaf/136148449821515692181/> ;
    skos:prefLabel "Nadine Garling" ;
    foaf:name "Nadine Garling" .

