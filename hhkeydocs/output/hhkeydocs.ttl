    jl:deathLocation <http://data.judaicalink.org/data/hhkeydocs/Rom> ;
    jl:describedAt <https://schluesseldokumente.net/person/gnd/127245642.jsonld> ;
    jl:hasAbstract "Österreichischer Rabbiner, Gelehrter und Funktionär der Israelitischen Kultusgemeinde Wien vor ihrer Auflösung durch die Nationalsozialisten im März 1938. Danach war er in der zwangsweise in „Jüdische Gemeinde Wien“ umbenannten Institution für die Auswanderungsabteilung zuständig. Später gehörte er dem Judenrat in Wien an. Anschließend war er der letzte Judenälteste im Konzentrationslager Theresienstadt." ;
    dcterms:created "2025-11-20T14:53:19.198338"^^xsd:dateTime ;
