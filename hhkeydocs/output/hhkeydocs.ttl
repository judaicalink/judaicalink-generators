    gndo:gndIdentifier "1165688786" ;
    jl:birthDate "1988" ;
    jl:birthLocation <http://data.judaicalink.org/data/hhkeydocs/Nordhorn> ;
    jl:describedAt <https://schluesseldokumente.net/person/gnd/1165688786.jsonld> ;
    jl:hasAbstract "Lisa Gerlach ist derzeit wissenschaftliche Mitarbeiterin am Lehrstuhl für „Transnationale Geschichte des 19. Jahrhunderts“ an der Ruhr Universität Bochum. Dort forscht sie zur Kulturgeschichte von Empfehlungsschreiben im Spiegel deutsch-jüdischer Netzwerke während der Moderne. Zuvor erhielt sie unter anderem Doktorandenstipendien des Sonderforschungsbereichs „Kulturen des Entscheidens“ (Westfälische Wilhelms Universität, Münster) und des Deutschen Historischen Instituts in Washington, DC. Sie studierte an der Freien Universität Berlin." ;
    dcterms:created "2025-11-20T14:48:57.889261"^^xsd:dateTime ;
    owl:sameAs <https://viaf.org/viaf/http://viaf.org/viaf/4606153596640651900001/> ;
    skos:prefLabel "Lisa Gerlach" ;
    foaf:name "Lisa Gerlach" .

