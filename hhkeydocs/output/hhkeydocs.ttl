    foaf:name "Dirk Brietzke" .

<http://data.judaicalink.org/data/hhkeydocs/Dirk_Rupnow> a foaf:Person ;
    gndo:gndIdentifier "122687183" ;
    jl:birthDate "1972" ;
    jl:birthLocation <http://data.judaicalink.org/data/hhkeydocs/Berlin> ;
    jl:describedAt <https://schluesseldokumente.net/person/gnd/122687183.jsonld> ;
    jl:hasAbstract "Dirk Rupnow, Univ.-Prof. Mag. Dr., geb. 1972, ist Leiter des Instituts für Zeitgeschichte an der Universität Innsbruck. Seine Forschungsschwerpunkte sind: österreichische, deutsche und europäische Zeitgeschichte, die NS-Zeit und der Holocaust, jüdische Geschichte, Wissenschaftsgeschichte, Kulturwissenschaften, transnationale Geschichte, Migrationsgeschichte sowie Theorie und Methode der Geschichtswissenschaft." ;
    dcterms:created "2025-11-20T14:52:49.470421"^^xsd:dateTime ;
    owl:sameAs <https://viaf.org/viaf/http://viaf.org/viaf/120027634/> ;
    skos:prefLabel "Dirk Rupnow" ;
    foaf:name "Dirk Rupnow" .

