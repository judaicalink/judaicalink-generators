<http://data.judaicalink.org/data/hhkeydocs/Carl_Eduard_Herzog_von_SachsenCoburg_und_Gotha> a foaf:Person ;
    gndo:gndIdentifier "118800590" ;
    jl:birthDate "1884-07-19" ;
