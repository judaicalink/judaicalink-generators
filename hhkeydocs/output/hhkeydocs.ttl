<http://data.judaicalink.org/data/hhkeydocs/Matthias_Brandis> a foaf:Person ;
    gndo:gndIdentifier "172009219" ;
    jl:birthDate "1939" ;
    jl:describedAt <https://schluesseldokumente.net/person/gnd/172009219.jsonld> ;
    jl:hasAbstract "Matthias Brandis wurde 1939 als Enkel von Heinrich und Hedwig Wohlwill in Hamburg geboren. Nach seiner Tätigkeit als Kinderarzt und ärztlicher Direktor der Unikinderklinik Marburg und Freiburg widmete er sich der Erforschung der weitverzweigten Familiengeschichte, die sich in dem Buch „Meines Großvaters Geige“ (Hentrich&Hentrich, 2020) nachlesen lässt." ;
    dcterms:created "2025-11-20T14:54:14.327148"^^xsd:dateTime,
        "2025-11-20T14:54:14.673808"^^xsd:dateTime ;
    owl:sameAs <https://viaf.org/viaf/http://viaf.org/viaf/201282890/> ;
    skos:prefLabel "Matthias Brandis" ;
    foaf:name "Matthias Brandis" .

<http://data.judaicalink.org/data/hhkeydocs/Matthias_Loeber> a foaf:Person ;
    gndo:gndIdentifier "1124167625" ;
    jl:describedAt <https://schluesseldokumente.net/person/gnd/1124167625.jsonld> ;
    jl:hasAbstract "Matthias Loeber ist Doktorand an der Universität Hamburg (Prof. Dr. Dr. Rainer Hering). Er forscht zum politisch rechten Vereinswesen in Hamburg und Bremen zwischen 1890 und 1925. Daneben ist er für die Gedenkstätte Yad Vashem und als Lehrbeauftragter an der Universität Bremen tätig. Er war Mitarbeiter im Projekt „Keine Zuflucht. Nirgends. Die Konferenz von Évian und die Fahrt der ST. LOUIS 1938/39“ in der Reihe „Aus den Akten auf die Bühne“ (Dr. Eva Schöck-Quinteros) an der Universität Bremen 2018/19." ;
    dcterms:created "2025-11-20T14:48:32.295796"^^xsd:dateTime ;
    owl:sameAs <https://viaf.org/viaf/http://viaf.org/viaf/1616148574300924430008/> ;
    skos:prefLabel "Matthias Loeber" ;
    foaf:name "Matthias Loeber" .

